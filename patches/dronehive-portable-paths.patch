diff --git a/drone/host_paths.py b/drone/host_paths.py
new file mode 100644
index 0000000..a8261bf
--- /dev/null
+++ b/drone/host_paths.py
@@ -0,0 +1,78 @@
+"""Resolve BOSS Windows host paths via env / app_root.
+
+F:\\GrokSelfLibrary, D:\\GrokCoreMemory, and G:\\AI-Home are one
+Windows host example, not the Linux contract. Unset env + missing drive
+falls back under app_root()/host so cwd does not pretend F: exists.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+_WIN_PREFIXES = (
+    ("F:/GrokSelfLibrary", "library_root"),
+    ("D:/GrokCoreMemory/continuous", "continuous_root"),
+    ("D:/GrokCoreMemory", "core_memory_root"),
+    ("G:/AI-Home", "ai_home"),
+    ("G:/AI-Center", "ai_center"),
+    ("G:/MASTER-CORE", "master_core"),
+)
+
+
+def _env_path(*names: str) -> Path | None:
+    for name in names:
+        raw = (os.environ.get(name) or "").strip()
+        if raw:
+            return Path(raw)
+    return None
+
+
+def _app_root() -> Path:
+    from drone.app.config import app_root
+
+    return app_root()
+
+
+def _win_or_host(win: Path, *env_names: str, rel: str) -> Path:
+    override = _env_path(*env_names)
+    if override is not None:
+        return override
+    if win.exists():
+        return win
+    return _app_root() / "host" / rel
+
+
+def library_root() -> Path:
+    return _win_or_host(Path(r"F:\GrokSelfLibrary"), "DRONEHIVE_LIBRARY_ROOT", "GROK_SELF_LIBRARY", rel="library")
+
+
+def continuous_root() -> Path:
+    return _win_or_host(Path(r"D:\GrokCoreMemory") / "continuous", "DRONEHIVE_CONTINUOUS_ROOT", rel="continuous")
+
+
+def core_memory_root() -> Path:
+    return _win_or_host(Path(r"D:\GrokCoreMemory"), "DRONEHIVE_CORE_MEMORY", rel="core-memory")
+
+
+def ai_home() -> Path:
+    return _win_or_host(Path(r"G:\AI-Home"), "DRONEHIVE_AI_HOME", "AI_HOME", rel="ai-home")
+
+
+def ai_center() -> Path:
+    return _win_or_host(Path(r"G:\AI-Center"), "DRONEHIVE_AI_CENTER", "AI_CENTER", rel="ai-center")
+
+
+def master_core() -> Path:
+    return _win_or_host(Path(r"G:\MASTER-CORE"), "DRONEHIVE_MASTER_CORE", rel="master-core")
+
+
+def resolve_host_path(raw: str | Path) -> Path:
+    """Map a hardcoded BOSS path onto env / app_root overlay."""
+    text = str(raw).replace("\\", "/")
+    for prefix, getter_name in _WIN_PREFIXES:
+        if text.lower().startswith(prefix.lower()):
+            getter = globals()[getter_name]
+            rest = text[len(prefix) :].lstrip("/")
+            base = getter()
+            return base.joinpath(*rest.split("/")) if rest else base
+    return Path(raw)
