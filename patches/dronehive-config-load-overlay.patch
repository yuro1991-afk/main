new file mode 100644
index 0000000..a580069
--- /dev/null
+++ b/drone/config_overlay.py
@@ -0,0 +1,24 @@
+"""Remap F:/D:/G: strings in loaded JSON configs via host_paths.
+
+Apply after dronehive-portable-paths so drone/host_paths.py exists.
+Does not edit drone/pro/tool_agent.py.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from .host_paths import resolve_host_path
+
+
+def remap_host_strings(obj: Any) -> Any:
+    """Walk dict/list JSON and remap Windows drive strings."""
+    if isinstance(obj, str):
+        if len(obj) >= 2 and obj[1] == ":" and obj[0].isalpha():
+            return str(resolve_host_path(obj))
+        return obj
+    if isinstance(obj, list):
+        return [remap_host_strings(item) for item in obj]
+    if isinstance(obj, dict):
+        return {key: remap_host_strings(value) for key, value in obj.items()}
+    return obj
